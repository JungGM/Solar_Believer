# Local development only. Run: python scripts/init_env.py
POSTGRES_DB=solar_believer
POSTGRES_USER=solar
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000

# disabled | demo | live (live adapter is intentionally unconfigured)
PIPELINE_MODE=disabled
# Five-field cron expressions; schedules are Asia/Seoul.
COLLECTION_CRON=15 * * * *
# KMA short-range forecasts: eight issues daily; attempt 20 minutes later.
FORECAST_CRON=20 2,5,8,11,14,17,20,23 * * *
PREDICTION_CRON=30 * * * *
RETRAINING_CRON=0 3 1 * *
SCHEDULER_TIMEZONE=Asia/Seoul
COLLECTION_LOOKBACK_DAYS=2
MODEL_ARTIFACT_DIR=artifacts

# Supply your own issued keys only when integrating real collectors.
DATA_GO_KR_API_KEY=
KMA_APIHUB_KEY=

# =================================================================
# K-VPP Insight API Configuration
# 공공데이터포털(data.go.kr) 및 기상청 API허브 인증키 설정
# =================================================================

# 공공데이터포털 디코딩(Decoding) API Key
# (KPX 태양광 발전량, KPX SMP, 기상청 단기예보, 기상청 ASOS 종관기상, 발전소 표준데이터 등)
DATA_GO_KR_API_KEY=YOUR_DECODED_SERVICE_KEY_HERE

# 기상청 API허브 API Key (선택 사항: apihub.kma.go.kr 백업용)
KMA_APIHUB_KEY=YOUR_KMA_APIHUB_KEY_HERE
